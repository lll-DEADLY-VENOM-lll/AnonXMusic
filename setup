#!/bin/bash

# --- Functions ---
pprint() {
    local msg="$1" c="$2" r="\033[0m"
    case "$c" in
        cred) c="\033[0;31m";; 
        cgreen) c="\033[0;32m";;
        cyellow) c="\033[0;33m";; 
        cblue) c="\033[0;34m";;
        cmagenta) c="\033[0;35m";;
        *) c="\033[0;35m";;
    esac
    printf "%b%b%b" "$c" "$msg" "$r"
}

# Check for Root/Sudo
if [ "$EUID" -ne 0 ]; then
    pprint "Please run this script with sudo or as root.\n" "cred"
    exit 1
fi

yesnoprompt() {
    read -rn1 -p "$1 (y/n): " answer
    case $answer in
        [Yy]* ) return 0;;
        * ) return 1;;
    esac
}

update_system() {
    pprint "\n\nUpdating package list...\n" "cblue"
    apt update -y
    if apt list --upgradable 2>/dev/null | grep -q "/"; then
        pprint "\nUpdates are available. Upgrade now? " "cyellow"
        if yesnoprompt ""; then
            pprint "\nUpgrading system packages... " "cblue"
            apt upgrade -y && pprint "Done.\n" "cgreen" || pprint "Failed.\n" "cred"
        fi
    else
        pprint "System is already up-to-date.\n" "cgreen"
    fi
}

install_pkg() {
    if ! command -v "$1" &>/dev/null; then
        pprint "Installing $1... " "cyellow"
        apt install -y "$2" &>/dev/null && pprint "Done.\n" "cgreen" || pprint "Failed.\n" "cred"
    else
        pprint "$1 is already installed.\n" "cgreen"
    fi
}

install_deno() {
    pprint "\nChecking Deno installation...\n" "cblue"
    if command -v deno &>/dev/null; then
        pprint "Deno already installed: $(deno --version | head -n1)\n" "cgreen"
    else
        pprint "Installing Deno... " "cyellow"
        curl -fsSL https://deno.land/install.sh | sh >/dev/null 2>&1
        
        # Path Handling
        DENO_BIN="$HOME/.deno/bin"
        if [[ ":$PATH:" != *":$DENO_BIN:"* ]]; then
            # Add to bashrck
            echo 'export DENO_INSTALL="$HOME/.deno"' >> ~/.bashrc
            echo 'export PATH="$DENO_INSTALL/bin:$PATH"' >> ~/.bashrc
            # Add to zshrc if exists
            [ -f ~/.zshrc ] && echo 'export PATH="$HOME/.deno/bin:$PATH"' >> ~/.zshrc
        fi
        export DENO_INSTALL="$HOME/.deno"
        export PATH="$DENO_INSTALL/bin:$PATH"
        pprint "Done.\n" "cgreen"
    fi
}

install_py_deps() {
    pprint "\nInstalling Python dependencies...\n" "cblue"
    pip3 install -U pip -q
    if [ -f "requirements.txt" ]; then
        if pip3 install -U -r requirements.txt -q; then
            pprint "Dependencies installed successfully.\n" "cgreen"
        else
            pprint "Failed to install some dependencies. Please check manually.\n" "cred"
        fi
    else
        pprint "requirements.txt not found. Skipping pip install.\n" "cyellow"
    fi
}

# --- Main Logic ---

clear
pprint "==============================================\n" "cmagenta"
pprint "   AnonXMusic Installation Setup (Updated)    \n" "cmagenta"
pprint "==============================================\n" "cmagenta"
sleep 1

update_system

# Install required tools
install_pkg "python3" "python3-pip"
install_pkg "ffmpeg" "ffmpeg"
install_pkg "unzip" "unzip"
install_pkg "curl" "curl"

install_deno
install_py_deps

pprint "\nInstallation phase completed.\n" "cgreen"
sleep 1

# --- Variable Collection ---
pprint "\n--- Configuration Setup ---\n" "cmagenta"

read -rp "API ID (Integer): " api_id
read -rp "API HASH: " api_hash
read -rp "BOT TOKEN: " bot_token
read -rp "OWNER ID: " ownid
read -rp "MONGO URL: " mongo_db
read -rp "LOG GROUP ID: " logger
read -rp "STRING SESSION: " string_session

# Save to .env
cat > .env <<EOF
API_ID=$api_id
API_HASH=$api_hash
BOT_TOKEN=$bot_token
MONGO_DB_URI=$mongo_db
LOGGER_ID=$logger
STRING_SESSION=$string_session
OWNER_ID=$ownid
EOF

pprint "\nSUCCESS: .env file has been generated!\n" "cgreen"
pprint "To start the bot, run:\n" "cblue"
pprint "   bash start\n\n" "cyellow"
